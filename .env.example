# Roborock account credentials. Keep the real .env uncommitted.
ROBO_EMAIL=you@example.com
ROBO_PASSWORD=your-password
# Optional one-time verification code; prefer interactive `vacuum-ballet login`.
# ROBO_CODE=123456

# Select the robot explicitly when the account has more than one vacuum.
# Prefer ROBO_DUID after running `uv run vacuum-ballet devices`.
ROBO_DEVICE_NAME=Garage Roborock
ROBO_DUID=

# Optional local cache location for login/device session data.
# ROBOROCK_CACHE_DIR=/Users/you/.cache/vacuum-ballet

# Conservative waypoint limits. Coordinates are map millimetres.
MIN_DANCE_RADIUS_MM=200
MAX_DANCE_RADIUS_MM=1200
DEFAULT_RADIUS=400
DEFAULT_BEAT_MS=500
MIN_DANCE_BEAT_MS=250
MAX_DANCE_WAYPOINTS=32

# Optional explicit dance centre. If omitted, dance uses the current map
# position and refuses to guess when no map position is available.
# DEFAULT_CENTER_X=32000
# DEFAULT_CENTER_Y=27000
